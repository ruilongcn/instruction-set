{
  "default_chain": ["cloud", "local"],
  "cloud": {
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "api_key_env": "CLOUD_LLM_API_KEY",
    "temperature": 0.4,
    "timeout_seconds": 120
  },
  "local": {
    "base_url": "http://127.0.0.1:11434",
    "model": "qwen2.5:7b",
    "temperature": 0.4,
    "timeout_seconds": 300
  }
}
